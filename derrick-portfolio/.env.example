# Environment variables for Vercel (Project settings > Environment Variables) or a local .env.local.
# Copy to .env.local for local use. .env.local is git-ignored; never commit real values.

# --- server only: read by api/contact.js. Never prefix these with VITE_ (that would put them in the page).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=

# --- built into the page (safe to expose)
# where the contact form posts; on Vercel: /api/contact. Leave empty to fall back to Web3Forms or the email app.
VITE_CONTACT_ENDPOINT=/api/contact
# optional: Web3Forms also emails each message to you (a Web3Forms access key is designed to be public)
VITE_WEB3FORMS_ACCESS_KEY=
